{
  "name": "NGC PyTorch",
  "dockerComposeFile": "../infra/brev/compose/ngc-pytorch.compose.yaml",
  "service": "jupyter",
  "workspaceFolder": "/workspace",
  "remoteUser": "1000",
  "overrideCommand": false,
  "shutdownAction": "none",
  "initializeCommand": "mkdir -p /home/ubuntu/.devcontainer-home",
  "mounts": [
    "source=/home/ubuntu/.devcontainer-home,target=/home/ubuntu,type=bind"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ]
    }
  }
}

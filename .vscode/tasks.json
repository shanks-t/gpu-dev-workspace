{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "GPU: Run Current Python File",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "-f",
        "infra/brev/compose/ngc-pytorch.compose.yaml",
        "exec",
        "-T",
        "jupyter",
        "python",
        "/workspace/${relativeFile}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "GPU: CUDA and PyTorch Check",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "-f",
        "infra/brev/compose/ngc-pytorch.compose.yaml",
        "exec",
        "-T",
        "jupyter",
        "python",
        "-c",
        "import torch; assert torch.cuda.is_available(); print(\"GPU:\", torch.cuda.get_device_name(0)); print(\"PyTorch:\", torch.__version__); print(\"CUDA:\", torch.version.cuda)"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "GPU: Open Runtime Shell",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "-f",
        "infra/brev/compose/ngc-pytorch.compose.yaml",
        "exec",
        "jupyter",
        "bash"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}

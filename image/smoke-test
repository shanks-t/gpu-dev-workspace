#!/bin/sh
set -eu

mode=${1:---gpu}
case "$mode" in
  --build | --compile | --gpu) ;;
  *) echo "usage: gpu-image-smoke-test [--build|--compile|--gpu]" >&2; exit 2 ;;
esac

for tool in cmake git jq ncu ninja nsys nvcc python rsync sshd; do
  command -v "$tool" >/dev/null 2>&1 || {
    echo "gpu-image: missing required command: $tool" >&2
    exit 1
  }
done

python - <<'PY'
import numpy
import torch
import triton

assert numpy.__version__ == "2.3.5", numpy.__version__
assert torch.__version__ == "2.9.1+cu130", torch.__version__
assert triton.__version__ == "3.5.1", triton.__version__
print(f"NumPy {numpy.__version__}; PyTorch {torch.__version__}; Triton {triton.__version__}")
PY

nvcc --version | tail -n 1
ncu --version | sed -n '1,4p'
nsys --version | sed -n '1p'

if [ "$mode" = --build ]; then
  echo "gpu-image: static toolchain validation passed"
  exit 0
fi

nvcc -O2 -lineinfo /opt/gpu-workspace-smoke/cuda_smoke.cu -o /tmp/cuda-smoke
if [ "$mode" = --compile ]; then
  echo "gpu-image: native CUDA compilation passed"
  exit 0
fi

nvidia-smi --query-gpu=name,driver_version --format=csv,noheader
/tmp/cuda-smoke
python /opt/gpu-workspace-smoke/pytorch_smoke.py
echo "gpu-image: GPU validation passed"

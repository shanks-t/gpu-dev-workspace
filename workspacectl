#!/usr/bin/env python3
"""Manage declarative RunPod development workspaces."""

from __future__ import annotations

import argparse
import json
from pathlib import Path

from runpod_workspace import api, config


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    for name in ("plan", "create"):
        command = commands.add_parser(name)
        command.add_argument("configuration", type=Path)
        command.add_argument("--set", dest="overrides", action="append", default=[], metavar="PATH=JSON")
        if name == "create":
            command.add_argument("--apply", action="store_true", help="make the POST request")
    command = commands.add_parser("status")
    command.add_argument("pod_id")
    command = commands.add_parser("stop")
    command.add_argument("pod_id")
    command.add_argument("--apply", action="store_true")
    command = commands.add_parser("destroy")
    command.add_argument("pod_id")
    command.add_argument("--confirm", metavar="POD_ID")
    args = parser.parse_args()

    if args.command in {"plan", "create"}:
        payload = config.create_payload(config.load(args.configuration, args.overrides))
        if args.command == "plan" or not args.apply:
            print(json.dumps({"method": "POST", "path": "/pods", "body": payload}, indent=2))
            return 0
        print(json.dumps(api.request("POST", "/pods", payload), indent=2))
    elif args.command == "status":
        print(json.dumps(api.request("GET", f"/pods/{args.pod_id}"), indent=2))
    elif args.command == "stop":
        if not args.apply:
            print(f"DRY RUN: POST /pods/{args.pod_id}/stop (pass --apply to execute)")
        else:
            print(json.dumps(api.request("POST", f"/pods/{args.pod_id}/stop"), indent=2))
    elif args.command == "destroy":
        if args.confirm != args.pod_id:
            parser.error("destroy requires --confirm with the exact pod ID")
        print(json.dumps(api.request("DELETE", f"/pods/{args.pod_id}"), indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

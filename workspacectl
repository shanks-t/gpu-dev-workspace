#!/usr/bin/env python3
"""Manage declarative RunPod development workspaces."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import shlex
import subprocess

from runpod_workspace import api, config
from runpod_workspace.ssh import rsync_command


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    for name in ("plan", "create"):
        command = commands.add_parser(name)
        command.add_argument("configuration", type=Path)
        command.add_argument("--set", dest="overrides", action="append", default=[], metavar="PATH=JSON")
        if name == "create":
            command.add_argument("--apply", action="store_true", help="make the POST request")
    for name in ("volume-plan", "volume-create"):
        command = commands.add_parser(name)
        command.add_argument("configuration", type=Path)
        if name == "volume-create":
            command.add_argument("--apply", action="store_true", help="make the POST request")
    command = commands.add_parser("status")
    command.add_argument("pod_id")
    command.add_argument("--raw", action="store_true")
    command = commands.add_parser("logs")
    command.add_argument("pod_id")
    command = commands.add_parser("stop")
    command.add_argument("pod_id")
    command.add_argument("--apply", action="store_true")
    command = commands.add_parser("start")
    command.add_argument("pod_id")
    command.add_argument("--apply", action="store_true")
    command = commands.add_parser("destroy")
    command.add_argument("pod_id")
    command.add_argument("--confirm", metavar="POD_ID")
    command = commands.add_parser("sync")
    command.add_argument("pod_id")
    command.add_argument("--source", type=Path, default=Path.cwd())
    command.add_argument("--remote-path", default="/workspace/gpu-dev-workspace")
    command.add_argument("--identity-file", type=Path, required=True)
    command.add_argument("--apply", action="store_true")
    args = parser.parse_args()

    if args.command in {"plan", "create"}:
        payload = config.create_payload(config.load(args.configuration, args.overrides))
        if args.command == "plan" or not args.apply:
            print(json.dumps({"method": "POST", "path": "/pods", "body": payload}, indent=2))
            return 0
        print(json.dumps(api.request("POST", "/pods", payload), indent=2))
    elif args.command in {"volume-plan", "volume-create"}:
        try:
            volume_config = json.loads(args.configuration.read_text())
        except (OSError, json.JSONDecodeError) as error:
            parser.error(f"Cannot read volume configuration: {error}")
        payload = config.network_volume_payload(volume_config)
        if args.command == "volume-plan" or not args.apply:
            print(json.dumps({"method": "POST", "path": "/networkvolumes", "body": payload}, indent=2))
            return 0
        print(json.dumps(api.request("POST", "/networkvolumes", payload), indent=2))
    elif args.command == "status":
        pod = api.request("GET", f"/pods/{args.pod_id}")
        print(json.dumps(pod if args.raw else api.status_summary(pod), indent=2))
    elif args.command == "logs":
        print(f"Open Pod {args.pod_id} in the RunPod Console and expand Logs:")
        print(f"https://www.runpod.io/console/pods/{args.pod_id}")
    elif args.command == "stop":
        if not args.apply:
            print(f"DRY RUN: POST /pods/{args.pod_id}/stop (pass --apply to execute)")
        else:
            print(json.dumps(api.request("POST", f"/pods/{args.pod_id}/stop"), indent=2))
    elif args.command == "start":
        if not args.apply:
            print(f"DRY RUN: POST /pods/{args.pod_id}/start (pass --apply to execute)")
        else:
            print(json.dumps(api.request("POST", f"/pods/{args.pod_id}/start"), indent=2))
    elif args.command == "destroy":
        if args.confirm != args.pod_id:
            parser.error("destroy requires --confirm with the exact pod ID")
        print(json.dumps(api.request("DELETE", f"/pods/{args.pod_id}"), indent=2))
    elif args.command == "sync":
        pod = api.request("GET", f"/pods/{args.pod_id}")
        command = rsync_command(pod, args.source, args.remote_path, args.identity_file)
        print(shlex.join(command))
        if args.apply:
            subprocess.run(command, check=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

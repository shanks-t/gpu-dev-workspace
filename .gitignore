.DS_Store

# Local RunPod configurations and run reports may contain provider resource IDs.
configs/*.local.json
reports/

# Local, dated planning artifacts. Keep the workflow and templates versioned.
specs/*
!specs/README.md
!specs/templates/
!specs/templates/spec.md
!specs/templates/tasks.md
__pycache__/
*.pyc
.gpu/
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!profiles/**/*.tfvars
*.tfplan
crash.log

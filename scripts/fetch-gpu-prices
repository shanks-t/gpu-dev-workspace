#!/bin/sh
set -eu

fail() {
  echo "fetch-gpu-prices: $*" >&2
  exit 1
}

need() {
  command -v "$1" >/dev/null 2>&1 || fail "missing command: $1"
}

runpod() {
  need curl
  need jq
  [ -n "${RUNPOD_API_KEY:-}" ] || fail "RUNPOD_API_KEY is not set"

  query='query { gpuTypes { id displayName memoryInGb community: lowestPrice(input: {gpuCount: 1, secureCloud: false}) { stockStatus uninterruptablePrice } secure: lowestPrice(input: {gpuCount: 1, secureCloud: true}) { stockStatus uninterruptablePrice } } }'
  curl -fsS https://api.runpod.io/graphql \
    -H "Authorization: Bearer $RUNPOD_API_KEY" \
    -H 'Content-Type: application/json' \
    --data "$(jq -cn --arg query "$query" '{query: $query}')" |
    jq -er '
      if .errors then error(.errors | tostring) else .data.gpuTypes end
      | (["gpu_id", "name", "vram_gb", "community_usd_hr", "community_stock", "secure_usd_hr", "secure_stock"]),
        (.[] | [
          .id,
          .displayName,
          .memoryInGb,
          (.community.uninterruptablePrice // ""),
          (.community.stockStatus // ""),
          (.secure.uninterruptablePrice // ""),
          (.secure.stockStatus // "")
        ])
      | @tsv
    '
}

gcp() {
  need curl
  need gcloud
  need jq

  access_token=$(gcloud auth application-default print-access-token 2>/dev/null) ||
    fail "GCP Application Default Credentials are unavailable; run 'gcloud auth application-default login'"
  temporary_dir=$(mktemp -d)
  trap 'rm -rf "$temporary_dir"' EXIT HUP INT TERM
  sku_file=$temporary_dir/skus.jsonl
  page_token=

  while :; do
    request_url='https://cloudbilling.googleapis.com/v1/services/6F81-5844-456A/skus?currencyCode=USD&pageSize=5000'
    if [ -n "$page_token" ]; then
      request_url="$request_url&pageToken=$page_token"
    fi
    response_file=$temporary_dir/response.json
    curl -fsS "$request_url" -H "Authorization: Bearer $access_token" >"$response_file"
    jq -c '
      .skus[]
      | select((.serviceRegions // []) | index("us-west1"))
      | {
          description,
          usageType: .category.usageType,
          price: (
            ((.pricingInfo[0].pricingExpression.tieredRates[0].unitPrice.units // "0") | tonumber)
            + ((.pricingInfo[0].pricingExpression.tieredRates[0].unitPrice.nanos // 0) / 1000000000)
          )
        }
    ' "$response_file" >>"$sku_file"
    page_token=$(jq -r '.nextPageToken // empty' "$response_file")
    [ -n "$page_token" ] || break
  done

  jq -sr '
    def price($description; $usage):
      first(.[] | select(.description == $description and .usageType == $usage) | .price);
    def rounded: . * 1000000 | round / 1000000;
    ["machine", "gpu", "vram_gb", "on_demand_usd_hr", "spot_usd_hr"],
    [
      "n1-standard-4 + T4", "T4", 16,
      ((4 * price("N1 Predefined Instance Core running in Americas"; "OnDemand"))
        + (15 * price("N1 Predefined Instance Ram running in Americas"; "OnDemand"))
        + price("Nvidia Tesla T4 GPU running in Americas"; "OnDemand") | rounded),
      ((4 * price("Spot Preemptible N1 Predefined Instance Core running in Americas"; "Preemptible"))
        + (15 * price("Spot Preemptible N1 Predefined Instance Ram running in Americas"; "Preemptible"))
        + price("Nvidia Tesla T4 GPU attached to Spot Preemptible VMs running in Americas"; "Preemptible") | rounded)
    ],
    [
      "g2-standard-4", "L4", 24,
      ((4 * price("G2 Instance Core running in Americas"; "OnDemand"))
        + (16 * price("G2 Instance Ram running in Americas"; "OnDemand"))
        + price("Nvidia L4 GPU running in Americas"; "OnDemand") | rounded),
      ((4 * price("Spot Preemptible G2 Instance Core running in Americas"; "Preemptible"))
        + (16 * price("Spot Preemptible G2 Instance Ram running in Americas"; "Preemptible"))
        + price("Nvidia L4 GPU attached to Spot Preemptible VMs running in Americas"; "Preemptible") | rounded)
    ],
    [
      "a2-highgpu-1g", "A100 40GB", 40,
      ((12 * price("A2 Instance Core running in Americas"; "OnDemand"))
        + (85 * price("A2 Instance Ram running in Americas"; "OnDemand"))
        + price("Nvidia Tesla A100 GPU running in Americas"; "OnDemand") | rounded),
      ((12 * price("Spot Preemptible A2 Instance Core running in Americas"; "Preemptible"))
        + (85 * price("Spot Preemptible A2 Instance Ram running in Americas"; "Preemptible"))
        + price("Nvidia Tesla A100 GPU attached to Spot Preemptible VMs running in Americas"; "Preemptible") | rounded)
    ]
    | @tsv
  ' "$sku_file"
}

case "${1:-}" in
  runpod) runpod ;;
  gcp) gcp ;;
  *) fail "usage: ./scripts/fetch-gpu-prices <runpod|gcp>" ;;
esac

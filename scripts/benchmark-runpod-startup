#!/bin/sh
set -eu

root=$(CDPATH='' cd -- "$(dirname "$0")/.." && pwd)
trials=${1:-1}
shift || true

case "$trials" in
  '' | *[!0-9]* | 0) echo "usage: $0 TRIALS PROFILE..." >&2; exit 2 ;;
esac
[ "$#" -gt 0 ] || {
  echo "usage: $0 TRIALS PROFILE..." >&2
  exit 2
}

run_id=$(date -u +%Y%m%dT%H%M%SZ)
results=$root/.gpu/benchmarks/$run_id
mkdir -p "$results"
active_log=

cleanup_active() {
  if terraform -chdir="$root/infra/runpod" state list 2>/dev/null | grep -q .; then
    "$root/gpu" down >>"${active_log:-$results/cleanup.log}" 2>&1 || true
  fi
}
trap cleanup_active EXIT HUP INT TERM

for profile in "$@"; do
  trial=1
  while [ "$trial" -le "$trials" ]; do
    prefix=$results/$profile-$trial
    active_log=$prefix.log
    echo "benchmark: profile=$profile trial=$trial"
    if "$root/gpu" up "$profile" >"$active_log" 2>&1; then
      cp "$root/.gpu/startup-runpod.json" "$prefix.json"
      jq -c '{profile, image, elapsed_seconds}' "$prefix.json"
      "$root/gpu" down >>"$active_log" 2>&1
    else
      status=$?
      printf '{"profile":"%s","trial":%s,"failed":true,"exit_status":%s}\n' \
        "$profile" "$trial" "$status" >"$prefix.json"
      cat "$active_log" >&2
      cleanup_active
    fi
    active_log=
    trial=$((trial + 1))
  done
done

jq -s '.' "$results"/*.json >"$results/results.json"
echo "benchmark: results written to $results/results.json"

#!/usr/bin/env python3
"""Render and safely execute NVIDIA Brev commands from tracked profiles."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import re
import shlex
import subprocess
import sys
from typing import Any

ROOT = Path(__file__).resolve().parents[3]
PROFILES = ROOT / "infra/brev/profiles"
MIN_VERSION = (0, 6, 334)


def profile_path(name: str) -> Path:
    path = PROFILES / f"{name}.json"
    if not path.is_file():
        raise ValueError(f"unknown profile {name!r}; expected one of: fundamentals, profiling")
    return path


def load_profile(name: str, overrides: list[str]) -> dict[str, Any]:
    profile = json.loads(profile_path(name).read_text())
    for assignment in overrides:
        key, separator, raw = assignment.partition("=")
        if not separator or key not in profile:
            raise ValueError(f"override must name an existing profile field: {assignment!r}")
        profile[key] = json.loads(raw)
    required = {"name", "gpu_count", "min_vram_gb", "min_compute_capability", "disk_gb", "stoppable", "max_boot_time_minutes", "max_hourly_price_usd", "runtime_deadline_minutes", "provider_preferences", "sort"}
    missing = required - profile.keys()
    if missing:
        raise ValueError(f"profile is missing: {', '.join(sorted(missing))}")
    if profile["gpu_count"] != 1 or profile["min_vram_gb"] < 1 or profile["disk_gb"] < 1:
        raise ValueError("profiles must request one GPU with positive VRAM and disk")
    if float(profile["min_compute_capability"]) < 8.0:
        raise ValueError("minimum compute capability must be 8.0 or newer")
    if profile.get("max_vram_gb") is not None and profile["max_vram_gb"] < profile["min_vram_gb"]:
        raise ValueError("max_vram_gb cannot be lower than min_vram_gb")
    if profile["max_hourly_price_usd"] <= 0 or profile["runtime_deadline_minutes"] <= 0:
        raise ValueError("price and runtime limits must be positive")
    if not isinstance(profile["provider_preferences"], list):
        raise ValueError("provider_preferences must be a list")
    return profile


def filters(profile: dict[str, Any]) -> list[str]:
    args = ["--min-vram", str(profile["min_vram_gb"]), "--min-capability", str(profile["min_compute_capability"]), "--min-disk", str(profile["disk_gb"]), "--max-boot-time", str(profile["max_boot_time_minutes"]), "--sort", profile["sort"]]
    if profile["stoppable"]:
        args.append("--stoppable")
    for provider in profile["provider_preferences"]:
        args.extend(["--provider", provider])
    return args


def rendered(profile: dict[str, Any]) -> dict[str, list[str]]:
    args = filters(profile)
    return {
        "search": ["brev", "search", "--json", *args],
        "create_dry_run": ["brev", "create", profile["name"], *args, "--dry-run"],
        "create": ["brev", "create", profile["name"], *args, "--timeout", str(profile["max_boot_time_minutes"] * 60)],
    }


def print_command(command: list[str]) -> None:
    print(shlex.join(command))


def require_brev() -> None:
    result = subprocess.run(["brev", "--version"], text=True, capture_output=True)
    if result.returncode:
        raise RuntimeError("Brev CLI is unavailable. Install it, then run `brev login` interactively.")
    match = re.search(r"(\d+)\.(\d+)\.(\d+)", result.stdout + result.stderr)
    if not match or tuple(map(int, match.groups())) < MIN_VERSION:
        raise RuntimeError("Brev CLI v0.6.334 or newer is required.")
    auth = subprocess.run(["brev", "list"], text=True, capture_output=True)
    if auth.returncode:
        raise RuntimeError("Brev authentication failed. Run `brev login` interactively, then retry.")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    subs = parser.add_subparsers(dest="command", required=True)
    for command in ("plan", "search", "create"):
        item = subs.add_parser(command)
        item.add_argument("profile", choices=("fundamentals", "profiling"))
        item.add_argument("--set", dest="overrides", action="append", default=[], metavar="FIELD=JSON")
        if command == "create":
            item.add_argument("--confirm-create", action="store_true")
            item.add_argument("--allow-price-increase", action="store_true")
    for command in ("list", "refresh"):
        subs.add_parser(command)
    for command in ("start", "stop", "delete", "shell", "open"):
        item = subs.add_parser(command)
        item.add_argument("instance")
        if command in {"start", "stop", "delete"}:
            item.add_argument("--confirm", action="store_true")
        if command == "open":
            item.add_argument("editor", nargs="?", default="code")
    item = subs.add_parser("port-forward")
    item.add_argument("instance")
    item.add_argument("--port", required=True)
    args = parser.parse_args()
    try:
        if args.command in {"plan", "search", "create"}:
            profile = load_profile(args.profile, args.overrides)
            commands = rendered(profile)
            if args.command == "plan":
                print(json.dumps({"profile": profile, "commands": {key: shlex.join(value) for key, value in commands.items()}}, indent=2))
                return 0
            command = commands["search" if args.command == "search" else "create_dry_run"]
            if args.command == "create" and args.confirm_create:
                if args.overrides and not args.allow_price_increase:
                    raise ValueError("overrides require --allow-price-increase after reviewing the new price ceiling")
                command = commands["create"]
            print_command(command)
            if args.command == "search":
                require_brev()
                return subprocess.run(command).returncode
            if args.command == "create" and not args.confirm_create:
                print("Dry run only. Re-run with --confirm-create after selecting an eligible result within max_hourly_price_usd.")
            if args.command == "create" and args.confirm_create:
                require_brev()
                return subprocess.run(command).returncode
            return 0
        command = ["brev", args.command]
        if args.command in {"start", "stop", "delete"}:
            command.append(args.instance)
            if not args.confirm:
                print_command(command)
                print(f"Dry run only. Re-run with --confirm to execute `brev {args.command}`.")
                return 0
        elif args.command in {"shell", "open"}:
            command.append(args.instance)
            if args.command == "open": command.append(args.editor)
        elif args.command == "port-forward":
            command.extend([args.instance, "--port", args.port])
        require_brev()
        print_command(command)
        return subprocess.run(command).returncode
    except (RuntimeError, ValueError, json.JSONDecodeError) as error:
        parser.error(str(error))
    return 2


if __name__ == "__main__":
    raise SystemExit(main())

#!/usr/bin/env bash
# Make Docker 29's version JSON compatible with VS Code Dev Containers.
set -euo pipefail

readonly docker_bin=/usr/bin/docker

if [[ "${1:-}" == version && "${2:-}" == --format && "${3:-}" == '{{json .}}' ]]; then
  "$docker_bin" "$@" | python3 -c '
import json
import sys

payload = json.load(sys.stdin)
client = payload.get("Client")
if isinstance(client, dict) and not client.get("Components"):
    client["Components"] = [{
        "Name": "Engine",
        "Version": client.get("Version", ""),
        "Details": {key: client[key] for key in (
            "ApiVersion", "Arch", "BuildTime", "GitCommit", "GoVersion", "Os"
        ) if key in client},
    }]
print(json.dumps(payload, separators=(",", ":")))
'
else
  exec "$docker_bin" "$@"
fi

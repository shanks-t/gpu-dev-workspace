#!/usr/bin/env bash
set -euo pipefail

instance=${1:?usage: sync-source INSTANCE [SOURCE]}
source_dir=${2:-$(git rev-parse --show-toplevel)}
remote_path=/home/ubuntu/workspace

brev refresh
ssh -G "$instance" >/dev/null
rsync -az --delete \
  --exclude .git --exclude __pycache__ --exclude .pytest_cache \
  --exclude .mypy_cache --exclude .venv --exclude '*.pyc' \
  --exclude .env --exclude '.env.*' \
  "${source_dir%/}/" "$instance:$remote_path/"

#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "usage: git-workspace-migrate INSTANCE --repo REPO --branch BRANCH --auth ssh-agent --backup ARCHIVE.tgz --approve-replacement" >&2
  exit 2
}

instance=${1:-}
[[ -n "$instance" ]] || usage
shift
repo=
branch=
auth=
backup=
approved=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --repo) repo=${2:-}; shift 2 ;;
    --branch) branch=${2:-}; shift 2 ;;
    --auth) auth=${2:-}; shift 2 ;;
    --backup) backup=${2:-}; shift 2 ;;
    --approve-replacement) approved=true; shift ;;
    *) usage ;;
  esac
done
[[ -n "$repo" && -n "$branch" && "$auth" == "ssh-agent" && -f "$backup" && "$approved" == true ]] || usage

backup_name="brev-workspace-backup-$(date +%Y%m%dT%H%M%S)-$$.tgz"
brev refresh
scp -o BatchMode=yes -o ControlMaster=no -o ControlPath=none "$backup" "$instance:/tmp/$backup_name"
ssh -A -o BatchMode=yes -o ControlMaster=no -o ControlPath=none "$instance" \
  bash -s -- "$repo" "$branch" "/tmp/$backup_name" <<'REMOTE'
set -euo pipefail
repo=$1
branch=$2
archive=$3
workspace=/home/ubuntu/workspace
timestamp=$(date -u +%Y%m%dT%H%M%SZ)

[[ $(id -un) == ubuntu ]] || { echo "REFUSE: migration must run as ubuntu" >&2; exit 1; }
test -r "$archive" || { echo "REFUSE: uploaded backup is unavailable" >&2; exit 1; }
test -w /home/ubuntu || { echo "REFUSE: /home/ubuntu is not writable" >&2; exit 1; }
if [[ -e "$workspace" && ! -d "$workspace" ]]; then
  echo "REFUSE: workspace is not a directory" >&2
  exit 1
fi
if [[ -d "$workspace/.git" ]]; then
  echo "REFUSE: existing Git checkout is not replaced by this migration" >&2
  exit 1
fi
if [[ -d "$workspace" && -n $(find "$workspace" -mindepth 1 -maxdepth 1 -print -quit) ]]; then
  old_workspace="${workspace}.pre-git-migration-${timestamp}"
  mv "$workspace" "$old_workspace"
  echo "previous workspace retained at: $old_workspace"
fi

git clone --branch "$branch" --single-branch "$repo" "$workspace"
commit=$(git -C "$workspace" rev-parse HEAD)
restore_dir=$(mktemp -d /tmp/brev-workspace-restore.XXXXXX)
trap 'rm -rf "$restore_dir" "$archive"' EXIT
tar -xzf "$archive" -C "$restore_dir"
cp -an "$restore_dir"/. "$workspace"/
printf '{\n  "repository": "%s",\n  "branch": "%s",\n  "commit": "%s",\n  "migrated_at": "%s"\n}\n' \
  "$repo" "$branch" "$commit" "$timestamp" >"$workspace/.brev-migration.json"
echo "checkout created: $workspace"
echo "starting commit: $commit"
echo "restored remote-only files are untracked; review with git status"
REMOTE

#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "usage: open-workspace INSTANCE [--confirm-start] [--pull] [--deadline-minutes MINUTES]" >&2
  exit 2
}

instance=${1:-}
[[ -n "$instance" ]] || usage
shift
confirm_start=false
pull_checkout=false
deadline_minutes=120
while [[ $# -gt 0 ]]; do
  case "$1" in
    --confirm-start) confirm_start=true; shift ;;
    --pull) pull_checkout=true; shift ;;
    --deadline-minutes) deadline_minutes=${2:-}; shift 2 ;;
    *) usage ;;
  esac
done
[[ "$deadline_minutes" =~ ^[1-9][0-9]*$ && "$deadline_minutes" -le 120 ]] || {
  echo "REFUSE: --deadline-minutes must be between 1 and 120" >&2
  exit 2
}

git_name=$(git config user.name || true)
git_email=$(git config user.email || true)
[[ -n "$git_name" && -n "$git_email" ]] || {
  echo "REFUSE: configure local Git user.name and user.email before opening the workspace" >&2
  exit 1
}

status=$(brev ls --json | jq -r --arg instance "$instance" \
  '.workspaces[] | select(.name == $instance) | .status')
[[ -n "$status" ]] || { echo "REFUSE: Brev instance not found: $instance" >&2; exit 1; }
started=false
case "$status" in
  STOPPED)
    [[ "$confirm_start" == true ]] || {
      echo "REFUSE: $instance is stopped; rerun with --confirm-start to incur runtime cost" >&2
      exit 1
    }
    brev start "$instance"
    started=true
    for _ in $(seq 1 84); do
      sleep 5
      status=$(brev ls --json | jq -r --arg instance "$instance" \
        '.workspaces[] | select(.name == $instance) | .status')
      [[ "$status" == RUNNING ]] && break
      [[ "$status" != ERROR && "$status" != STOPPING ]] || break
    done
    [[ "$status" == RUNNING ]] || { echo "REFUSE: instance did not reach RUNNING (status: $status)" >&2; exit 1; }
    ;;
  RUNNING) ;;
  *) echo "REFUSE: instance is not ready to open (status: $status)" >&2; exit 1 ;;
esac

brev refresh
if [[ "$started" == true ]]; then
  "$(dirname "$0")/watchdog" "$instance" "$deadline_minutes" --confirm-watchdog
fi

ssh -A -o BatchMode=yes -o ControlMaster=no -o ControlPath=none "$instance" \
  bash -s -- "$git_name" "$git_email" "$pull_checkout" <<'REMOTE'
set -euo pipefail
git_name=$1
git_email=$2
pull_checkout=$3
workspace=/home/ubuntu/workspace
compose_file=infra/brev/compose/ngc-pytorch.compose.yaml

[[ $(id -un) == ubuntu ]] || { echo "REFUSE: remote checkout user must be ubuntu" >&2; exit 1; }
test -d "$workspace/.git" || { echo "REFUSE: $workspace is not a Git checkout" >&2; exit 1; }
install -d --mode=0755 /home/ubuntu/.devcontainer-home
[[ $(git -C "$workspace" branch --show-current) == remote ]] || {
  echo "REFUSE: checkout is not on the remote branch" >&2
  exit 1
}
if [[ "$pull_checkout" == true ]]; then
  git -C "$workspace" pull --ff-only origin remote
fi
git -C "$workspace" config user.name "$git_name"
git -C "$workspace" config user.email "$git_email"
git -C "$workspace" ls-remote --exit-code origin refs/heads/remote </dev/null >/dev/null
if ! docker image inspect gpu-fundamentals-ngc-pytorch:24.07-py3 >/dev/null 2>&1; then
  docker compose -f "$compose_file" build jupyter
fi
if ss -ltn '( sport = :8889 )' | grep -q LISTEN \
  && [[ -z $(docker compose -f "$compose_file" ps --status running -q jupyter) ]]; then
  echo "REFUSE: port 8889 is occupied outside the NGC Jupyter service" >&2
  exit 1
fi
docker compose -f "$compose_file" up -d --no-build --no-deps jupyter
docker compose -f "$compose_file" exec -T jupyter sh -lc \
  'id -u | grep -qx 1000 && test "$HOME" = /home/ubuntu'
printf 'Workspace ready: Git %s <%s>; NGC Jupyter re-used on port 8889\n' "$git_name" "$git_email"
REMOTE

brev open "$instance" code --dir /home/ubuntu/workspace

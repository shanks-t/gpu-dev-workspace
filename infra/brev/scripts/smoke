#!/usr/bin/env bash
set -euo pipefail

instance=${1:?usage: smoke INSTANCE}
brev refresh
ssh "$instance" "bash -s" <<'REMOTE'
set -euo pipefail
cd /home/ubuntu/workspace
nvidia-smi
docker --version
docker run --rm --gpus all nvcr.io/nvidia/cuda:12.5.1-base-ubuntu22.04 nvidia-smi
docker compose -f infra/brev/compose/ngc-pytorch.compose.yaml run --rm pytorch -lc '
  nvidia-smi
  nvcc --version
  ncu --version
  nsys --version
  python -c "import torch; assert torch.cuda.is_available(); print(torch.cuda.get_device_name(0))"
  python curriculum/brev/gpu-mode-lecture-001/pytorch_square.py
'
REMOTE

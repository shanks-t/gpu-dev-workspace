#!/bin/sh
set -eu

root=$(CDPATH='' cd -- "$(dirname "$0")" && pwd)
provider=${GPU_PROVIDER:-runpod}
infra="$root/infra/$provider"
default_profile=book-ephemeral
remote_path=${GPU_REMOTE_PATH:-/workspace/gpu-dev-workspace}
ssh_dir=$HOME/.ssh
ssh_config=$ssh_dir/config
ssh_config_dir=$ssh_dir/config.d
ssh_include='Include ~/.ssh/config.d/gpu-workspace-*'
startup_file=$root/.gpu/startup-$provider.json

usage() {
  cat >&2 <<'EOF'
usage: GPU_PROVIDER=runpod|gcp ./gpu up [PROFILE]
       GPU_PROVIDER=runpod|gcp ./gpu <down|status|ssh|zed|check|cleanup>
EOF
  exit 2
}

fail() {
  echo "gpu: $*" >&2
  exit 1
}

need() {
  command -v "$1" >/dev/null 2>&1 || fail "missing command: $1"
}

tf() {
  terraform -chdir="$infra" "$@"
}

runpod_api() {
  [ -n "${RUNPOD_API_KEY:-}" ] || fail "RUNPOD_API_KEY is not set"
  curl -fsS -H "Authorization: Bearer $RUNPOD_API_KEY" "$@"
}

load_runpod_api_key() {
  if [ -n "${RUNPOD_API_KEY:-}" ]; then
    return 0
  fi
  command -v security >/dev/null 2>&1 ||
    fail "RUNPOD_API_KEY is unset and macOS security is unavailable"
  RUNPOD_API_KEY=$(
    security find-generic-password \
      -a "$USER" \
      -s "runpod-gpu-workspace" \
      -w 2>/dev/null
  ) || fail "RunPod API key not found in macOS Keychain service runpod-gpu-workspace"
  [ -n "$RUNPOD_API_KEY" ] || fail "RunPod API key in macOS Keychain is empty"
  export RUNPOD_API_KEY
}

runpod_pod_id() {
  tf_output pod_id
}

managed_profile() {
  tf_output profile_name
}

tf_output() {
  output_name=$1
  tf output -json 2>/dev/null |
    jq -er --arg name "$output_name" '.[$name].value | select(type == "string" and length > 0)'
}

profile_path() {
  name=$1
  case "$name" in
    '' | *[!A-Za-z0-9_-]*) fail "invalid profile name: $name" ;;
  esac
  path=$root/profiles/$name/$provider.tfvars
  [ -f "$path" ] || fail "profile not found for $provider: $path"
  printf '%s\n' "$path"
}

validate_profile() {
  requested=$1
  if current=$(managed_profile); then
    [ "$current" = "$requested" ] ||
      fail "workspace uses profile '$current'; run 'down' or 'cleanup' before switching to '$requested'"
  fi
}

managed_profile_path() {
  name=$(managed_profile) || fail "no managed $provider workspace"
  profile_path "$name"
}

runpod_endpoint() {
  pod_id=$(runpod_pod_id) || return 1
  runpod_api "https://rest.runpod.io/v1/pods/$pod_id" |
    jq -er '[.publicIp, (.portMappings["22"] | tostring)] | @tsv'
}

gcp_endpoint() {
  printf '%s\t%s\n' "$(tf_output public_ip)" 22
}

endpoint() {
  case "$provider" in
    runpod) runpod_endpoint ;;
    gcp) gcp_endpoint ;;
    *) fail "unsupported provider: $provider" ;;
  esac
}

ssh_user() {
  case "$provider" in
    runpod) echo root ;;
    gcp) tf_output ssh_user ;;
  esac
}

ssh_key() {
  case "$provider" in
    runpod) echo "${RUNPOD_SSH_KEY:-$HOME/.ssh/gpu_dev_ed25519}" ;;
    gcp) echo "${GCP_SSH_KEY:-$HOME/.ssh/id_ed25519}" ;;
  esac
}

ssh_alias() {
  printf 'gpu-%s\n' "$provider"
}

ensure_ssh_config_include() {
  mkdir -p "$ssh_config_dir"
  chmod 700 "$ssh_dir" "$ssh_config_dir"

  if [ -f "$ssh_config" ] && grep -Fqx "$ssh_include" "$ssh_config"; then
    return
  fi
  [ ! -L "$ssh_config" ] || fail "$ssh_config is a symlink; add '$ssh_include' at the top manually"

  if [ -f "$ssh_config" ] && [ ! -f "$ssh_config.gpu-workspace.bak" ]; then
    cp -p "$ssh_config" "$ssh_config.gpu-workspace.bak"
  fi

  temporary=$(mktemp "$ssh_dir/.config.gpu-workspace.XXXXXX")
  printf '%s\n' "$ssh_include" >"$temporary"
  if [ -f "$ssh_config" ]; then
    cat "$ssh_config" >>"$temporary"
  fi
  chmod 600 "$temporary"
  mv "$temporary" "$ssh_config"
  echo "gpu: added $ssh_include to $ssh_config"
}

write_ssh_alias() {
  host=$1
  port=$2
  user=$(ssh_user)
  key=$(ssh_key)
  alias=$(ssh_alias)
  [ -f "$key" ] || fail "SSH private key not found: $key"
  ensure_ssh_config_include

  target=$ssh_config_dir/gpu-workspace-$provider
  temporary=$(mktemp "$ssh_config_dir/.gpu-workspace-$provider.XXXXXX")
  {
    printf 'Host %s\n' "$alias"
    printf '    HostName %s\n' "$host"
    printf '    User %s\n' "$user"
    printf '    Port %s\n' "$port"
    printf '    IdentityFile "%s"\n' "$key"
    printf '%s\n' \
      '    IdentitiesOnly yes' \
      '    PasswordAuthentication no' \
      '    KbdInteractiveAuthentication no' \
      '    AddKeysToAgent yes' \
      '    UseKeychain yes' \
      '    ForwardAgent no' \
      '    ServerAliveInterval 30' \
      '    ServerAliveCountMax 3'
  } >"$temporary"
  chmod 600 "$temporary"
  ssh -F "$temporary" -G "$alias" >/dev/null 2>&1 || {
    rm -f "$temporary"
    fail "generated SSH alias is invalid: $alias"
  }
  mv "$temporary" "$target"
  ssh -G "$alias" >/dev/null 2>&1 || fail "generated SSH alias is invalid: $alias"
  echo "gpu: updated SSH alias $alias"
}

refresh_ssh_alias() {
  address=$(endpoint) || fail "provider has no running SSH endpoint"
  host=${address%%	*}
  port=${address#*	}
  write_ssh_alias "$host" "$port"
}

wait_for_ssh() {
  i=0
  endpoint_ready_at=
  while [ "$i" -lt 120 ]; do
    if address=$(endpoint 2>/dev/null); then
      if [ -z "$endpoint_ready_at" ]; then
        endpoint_ready_at=$(date +%s)
      fi
      host=${address%%	*}
      port=${address#*	}
      if ssh -o BatchMode=yes -o ConnectTimeout=5 -o IdentitiesOnly=yes \
        -o PasswordAuthentication=no -o KbdInteractiveAuthentication=no \
        -o StrictHostKeyChecking=accept-new \
        -i "$(ssh_key)" -p "$port" "$(ssh_user)@$host" true 2>/dev/null; then
        printf '%s\t%s\t%s\t%s\n' "$host" "$port" "$endpoint_ready_at" "$(date +%s)"
        return
      fi
    fi
    i=$((i + 1))
    sleep 5
  done
  fail "SSH was not ready after 10 minutes"
}

record_startup_timings() {
  started_at=$1
  terraform_ready_at=$2
  endpoint_ready_at=$3
  ssh_ready_at=$4
  image_ready_at=$5
  workspace_ready_at=$6
  image_name=$(tf_output image_name 2>/dev/null || true)
  resource_id=$(tf_output pod_id 2>/dev/null || tf_output instance_name 2>/dev/null || true)
  mkdir -p "$root/.gpu"
  temporary=$(mktemp "$root/.gpu/.startup-$provider.XXXXXX")
  jq -n \
    --arg provider "$provider" \
    --arg profile "$profile" \
    --arg resourceId "$resource_id" \
    --arg image "$image_name" \
    --argjson started "$started_at" \
    --argjson terraform "$terraform_ready_at" \
    --argjson endpoint "$endpoint_ready_at" \
    --argjson ssh "$ssh_ready_at" \
    --argjson imageReady "$image_ready_at" \
    --argjson workspace "$workspace_ready_at" \
    '{
      provider: $provider,
      profile: $profile,
      resource_id: $resourceId,
      image: $image,
      milestones_unix: {
        started: $started,
        terraform_ready: $terraform,
        endpoint_ready: $endpoint,
        ssh_ready: $ssh,
        image_ready: $imageReady,
        workspace_ready: $workspace
      },
      elapsed_seconds: {
        terraform: ($terraform - $started),
        endpoint: ($endpoint - $started),
        ssh: ($ssh - $started),
        image: ($imageReady - $started),
        workspace: ($workspace - $started)
      }
    }' >"$temporary"
  mv "$temporary" "$startup_file"
  echo "gpu: startup timings written to $startup_file"
}

record_zed_launch() {
  [ -f "$startup_file" ] || return 0
  launched_at=$(date +%s)
  temporary=$(mktemp "$root/.gpu/.startup-$provider.XXXXXX")
  jq --argjson launched "$launched_at" \
    '.milestones_unix.zed_launched = $launched |
     .elapsed_seconds.zed_launch = ($launched - .milestones_unix.started)' \
    "$startup_file" >"$temporary"
  mv "$temporary" "$startup_file"
}

ssh_exec() {
  refresh_ssh_alias
  exec ssh "$(ssh_alias)" "$@"
}

validate_runpod_image() {
  alias=$1
  mode=$(tf_output validation_mode)
  ssh "$alias" 'set -eu
    attempt=0
    until nvidia-smi -L >/dev/null 2>&1; do
      attempt=$((attempt + 1))
      if [ "$attempt" -ge 60 ]; then
        echo "GPU was not usable within two minutes after SSH became ready" >&2
        exit 1
      fi
      sleep 2
    done'
  case "$mode" in
    cuda)
      ssh "$alias" 'set -eu
        for tool in nvidia-smi nvcc c++; do
          command -v "$tool" >/dev/null || { echo "missing tool: $tool" >&2; exit 1; }
        done
        printf "%s\n" \
          "#include <cuda_runtime.h>" \
          "#include <cstdio>" \
          "int main() { int count = 0; if (cudaGetDeviceCount(&count) != cudaSuccess || count < 1) return 1; std::printf(\"CUDA devices: %d\\n\", count); }" \
          > /tmp/gpu-basics-smoke.cu
        nvcc /tmp/gpu-basics-smoke.cu -o /tmp/gpu-basics-smoke
        /tmp/gpu-basics-smoke
        rm -f /tmp/gpu-basics-smoke /tmp/gpu-basics-smoke.cu'
      ;;
    pytorch)
      ssh "$alias" 'set -eu
        command -v nvidia-smi >/dev/null || { echo "missing tool: nvidia-smi" >&2; exit 1; }
        python -c "import numpy, torch; assert torch.cuda.is_available(); value = (torch.ones(1024, device=\"cuda\") * 2).sum().item(); assert value == 2048; print(f\"PyTorch {torch.__version__}; CUDA tensor passed\")"'
      ;;
    nvidia-performance)
      ssh "$alias" 'set -eu
        for tool in nvidia-smi nvcc ncu nsys python; do
          command -v "$tool" >/dev/null || { echo "missing tool: $tool" >&2; exit 1; }
        done
        ncu --version | tail -n 1
        nsys --version | tail -n 1
        python -c "import torch; assert torch.cuda.is_available(); print(f\"PyTorch {torch.__version__}; CUDA available\")"'
      ;;
    performance-full) ssh "$alias" gpu-image-smoke-test --gpu ;;
    *) fail "unsupported RunPod validation mode: $mode" ;;
  esac
}

up() {
  [ "$#" -le 1 ] || usage
  profile=${1:-$default_profile}
  need terraform
  need curl
  need jq
  need ssh
  started_at=$(date +%s)
  profile_file=$(profile_path "$profile")
  tf init -input=false
  validate_profile "$profile"
  case "$provider" in
    runpod)
      if pod_id=$(runpod_pod_id 2>/dev/null); then
        if ! runpod_api -X POST "https://rest.runpod.io/v1/pods/$pod_id/start" >/dev/null 2>&1; then
          tf apply -auto-approve -var-file="$profile_file"
        fi
      else
        tf apply -auto-approve -var-file="$profile_file"
      fi
      ;;
    gcp) tf apply -auto-approve -var=desired_status=RUNNING -var-file="$profile_file" ;;
    *) fail "unsupported provider: $provider" ;;
  esac
  terraform_ready_at=$(date +%s)

  address=$(wait_for_ssh)
  previous_ifs=$IFS
  IFS='	'
  # shellcheck disable=SC2086
  set -- $address
  IFS=$previous_ifs
  host=$1
  port=$2
  endpoint_ready_at=$3
  ssh_ready_at=$4
  write_ssh_alias "$host" "$port"
  alias=$(ssh_alias)
  case "$provider" in
    runpod) validate_runpod_image "$alias" ;;
    gcp)
      ssh "$alias" \
        'set -eu
        for tool in nvidia-smi nvcc ncu python3; do command -v "$tool" >/dev/null; done
        nvidia-smi --query-gpu=name,driver_version --format=csv,noheader
        nvcc --version | tail -n 1
        python3 -c "import torch, triton; assert torch.cuda.is_available(); print(f\"PyTorch {torch.__version__}; Triton {triton.__version__}\")"'
      ;;
  esac
  image_ready_at=$(date +%s)

  # remote_path is intentionally expanded locally and quoted for the remote shell.
  # shellcheck disable=SC2029
  if [ ! -d "$root/.git" ]; then
    echo "gpu: local repository is not committed; skipping workspace seed" >&2
  elif ! ssh "$alias" "test -d '$remote_path/.git'"; then
    ssh "$alias" "mkdir -p '$remote_path'"
    git -C "$root" archive HEAD | ssh "$alias" \
      "tar -x -C '$remote_path' && cd '$remote_path' && git init -q && git add . && git -c user.name='GPU Workspace' -c user.email='gpu-workspace@localhost' commit -qm 'chore: seed workspace'"
  fi
  workspace_ready_at=$(date +%s)
  record_startup_timings "$started_at" "$terraform_ready_at" "$endpoint_ready_at" \
    "$ssh_ready_at" "$image_ready_at" "$workspace_ready_at"
  echo "gpu: ready ($provider, profile=$profile); run './gpu zed'"
}

down() {
  profile_file=$(managed_profile_path)
  down_action=$(tf_output down_action) || fail "profile has no down_action output"
  if [ "$down_action" = destroy ]; then
    tf destroy -auto-approve -var-file="$profile_file"
    echo "gpu: ephemeral $provider workspace deleted; no managed disk was retained"
    return
  fi
  [ "$down_action" = stop ] || fail "unsupported profile down_action: $down_action"
  case "$provider" in
    runpod)
      pod_id=$(runpod_pod_id) || fail "no managed RunPod Pod"
      runpod_api -X POST "https://rest.runpod.io/v1/pods/$pod_id/stop" >/dev/null
      ;;
    gcp) tf apply -auto-approve -var=desired_status=TERMINATED -var-file="$profile_file" ;;
    *) fail "unsupported provider: $provider" ;;
  esac
  echo "gpu: persistent $provider workspace stopped; storage remains and may still be billed"
}

status() {
  case "$provider" in
    runpod)
      pod_id=$(runpod_pod_id) || fail "no managed RunPod Pod"
      runpod_api "https://rest.runpod.io/v1/pods/$pod_id" |
        jq '{id, name, desiredStatus, gpu: .gpu.displayName, costPerHr, publicIp, sshPort: .portMappings["22"]}'
      ;;
    gcp) tf output -json | jq '{name: .instance_name.value, status: .status.value, publicIp: .public_ip.value}' ;;
    *) fail "unsupported provider: $provider" ;;
  esac
}

check() {
  need terraform
  need ssh
  need curl
  need jq
  need shellcheck
  shellcheck "$root/gpu" "$root"/image/start-gpu-workspace "$root"/image/smoke-test \
    "$root"/scripts/* "$root"/tests/*.sh
  for test_script in "$root"/tests/*.sh; do
    "$test_script"
  done
  terraform fmt -check -recursive "$root/infra"
  terraform fmt -check -recursive "$root/profiles"
  for dir in "$root/infra/runpod" "$root/infra/gcp"; do
    terraform -chdir="$dir" init -backend=false -input=false >/dev/null
    terraform -chdir="$dir" validate
  done
  echo "gpu: local checks passed"
}

cleanup() {
  profile_file=$(managed_profile_path)
  printf 'Type %s to permanently delete its compute and disk: ' "$provider" >&2
  read -r answer
  [ "$answer" = "$provider" ] || fail "cleanup cancelled"
  tf destroy -auto-approve -var-file="$profile_file"
}

[ -d "$infra" ] || fail "unsupported provider: $provider"
command=${1:-}
shift || true
if [ "$provider" = runpod ]; then
  case "$command" in
    up | down | status | ssh | zed | cleanup) load_runpod_api_key ;;
  esac
fi
case "$command" in
  up) up "$@" ;;
  down) down ;;
  status) status ;;
  ssh) ssh_exec "$@" ;;
  zed)
    need zed
    refresh_ssh_alias
    record_zed_launch
    exec zed "ssh://$(ssh_alias)$remote_path"
    ;;
  check) check ;;
  cleanup) cleanup ;;
  *) usage ;;
esac
